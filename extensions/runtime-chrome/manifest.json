{
  "manifest_version": 3,
  "name": "Runtime Chrome Bridge",
  "version": "0.3.0",
  "description": "Lets the local Runtime control explicitly attached Chrome tabs through Chrome DevTools Protocol and Native Messaging.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "downloads",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Runtime Chrome Bridge",
    "default_popup": "popup.html"
  }
}
