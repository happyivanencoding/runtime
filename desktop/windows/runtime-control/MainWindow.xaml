<Window x:Class="Runtime.Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Runtime Control"
        Width="1120" Height="780" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar -->
    <Border Grid.Row="0" Background="#0C1016" BorderBrush="#202837" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="46" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
          <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource AccentSoftBrush}" Margin="0,0,9,0">
            <TextBlock Text="R" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Runtime Control" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Content="—" Style="{StaticResource GhostButton}" Padding="0" Margin="0"
                Background="Transparent" Click="MinimizeButton_Click" />
        <Button Grid.Column="2" Content="□" Style="{StaticResource GhostButton}" Padding="0" Margin="0"
                Background="Transparent" Click="MaximizeButton_Click" />
        <Button Grid.Column="3" Content="×" Style="{StaticResource GhostButton}" Padding="0" Margin="0"
                Background="Transparent" Click="CloseButton_Click" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#202837" BorderThickness="0,0,1,0">
        <Grid Margin="20,22,20,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Margin="2,0,0,22">
            <StackPanel Orientation="Horizontal">
              <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,11,0">
                <Grid>
                  <Ellipse Width="22" Height="22" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0.85" />
                  <TextBlock Text="R" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Runtime" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="LOCAL CONTROL PLANE" Style="{StaticResource MutedText}" FontSize="9" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <TextBlock Grid.Row="1" Text="CONTROL" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,7" />

          <StackPanel Grid.Row="2">
            <RadioButton x:Name="NavOverview" Content="概览" Tag="0" IsChecked="True" Checked="Navigation_Click" Style="{StaticResource NavRadio}" />
            <RadioButton Content="连接" Tag="1" Checked="Navigation_Click" Style="{StaticResource NavRadio}" />
            <RadioButton Content="浏览器" Tag="2" Checked="Navigation_Click" Style="{StaticResource NavRadio}" />
            <RadioButton Content="ACP" Tag="3" Checked="Navigation_Click" Style="{StaticResource NavRadio}" />
            <RadioButton Content="电脑控制" Tag="4" Checked="Navigation_Click" Style="{StaticResource NavRadio}" />
            <RadioButton Content="日志与设置" Tag="5" Checked="Navigation_Click" Style="{StaticResource NavRadio}" />
          </StackPanel>

          <Border Grid.Row="3" Background="#111821" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="#667085" Margin="0,0,8,0" />
                <TextBlock x:Name="SidebarStatusText" Text="正在读取" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock x:Name="SidebarVersionText" Grid.Row="1" Text="Runtime Core" Style="{StaticResource MutedText}" Margin="16,5,0,0" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Main content -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" TabStripPlacement="Left" BorderThickness="0" Background="Transparent">
          <TabControl.Resources>
            <Style TargetType="TabPanel">
              <Setter Property="Visibility" Value="Collapsed" />
            </Style>
          </TabControl.Resources>

          <!-- Overview -->
          <TabItem>
            <ScrollViewer Padding="28,26,28,30">
              <StackPanel>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="运行概览" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Runtime Core、浏览器桥接与远程控制链路的实时状态。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开状态目录" Style="{StaticResource GhostButton}" Click="OpenRuntimeHome_Click" Margin="0,0,8,0" />
                    <Button Content="刷新" Style="{StaticResource PrimaryButton}" Click="Refresh_Click" />
                  </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Background="#111B24">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="CoreHeroDot" Width="10" Height="10" Fill="#667085" Margin="0,4,10,0" />
                        <TextBlock x:Name="CoreHeroTitle" Text="Runtime Core" FontSize="18" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock x:Name="CoreHeroSubtitle" Text="正在读取本地安装状态…" Style="{StaticResource MutedText}" FontSize="13" Margin="20,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0E2B33" BorderBrush="#21424B" BorderThickness="1" CornerRadius="10" Padding="12,8" VerticalAlignment="Center">
                      <TextBlock x:Name="CoreProcessText" Text="0 processes" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                  </Grid>
                </Border>

                <UniformGrid Columns="3" Rows="2" Margin="0,0,0,16">
                  <Border Style="{StaticResource SmallCard}" Margin="0,0,8,8">
                    <StackPanel>
                      <TextBlock Text="MCP" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse x:Name="McpDot" Width="9" Height="9" Fill="#667085" Margin="0,4,8,0" />
                        <TextBlock x:Name="McpStatusText" Text="本地可用" FontSize="15" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock x:Name="McpDetailText" Text="stdio" Style="{StaticResource MutedText}" Margin="17,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource SmallCard}" Margin="4,0,4,8">
                    <StackPanel>
                      <TextBlock Text="CHROME BRIDGE" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse x:Name="BrowserDot" Width="9" Height="9" Fill="#667085" Margin="0,4,8,0" />
                        <TextBlock x:Name="BrowserStatusText" Text="检查中" FontSize="15" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock x:Name="BrowserDetailText" Text="Native Messaging" Style="{StaticResource MutedText}" Margin="17,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource SmallCard}" Margin="8,0,0,8">
                    <StackPanel>
                      <TextBlock Text="CHATGPT" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse x:Name="ChatGptDot" Width="9" Height="9" Fill="#667085" Margin="0,4,8,0" />
                        <TextBlock x:Name="ChatGptStatusText" Text="未配置" FontSize="15" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock x:Name="ChatGptDetailText" Text="等待直接 MCP" Style="{StaticResource MutedText}" Margin="17,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource SmallCard}" Margin="0,4,8,0">
                    <StackPanel>
                      <TextBlock Text="ACP" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource WarningBrush}" Margin="0,4,8,0" />
                        <TextBlock Text="Dormant" FontSize="15" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock x:Name="AcpDetailText" Text="默认关闭" Style="{StaticResource MutedText}" Margin="17,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource SmallCard}" Margin="4,4,4,0">
                    <StackPanel>
                      <TextBlock Text="WINDOWS UIA" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse x:Name="UiaDot" Width="9" Height="9" Fill="#667085" Margin="0,4,8,0" />
                        <TextBlock x:Name="UiaStatusText" Text="Ready" FontSize="15" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock x:Name="UiaDetailText" Text="普通用户权限" Style="{StaticResource MutedText}" Margin="17,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource SmallCard}" Margin="8,4,0,0">
                    <StackPanel>
                      <TextBlock Text="AGENTDOCK FALLBACK" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse x:Name="AgentDockDot" Width="9" Height="9" Fill="#667085" Margin="0,4,8,0" />
                        <TextBlock x:Name="AgentDockStatusText" Text="检查中" FontSize="15" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock Text="保留，不由 Runtime Control 修改" Style="{StaticResource MutedText}" Margin="17,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="安全边界" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="ACP 不会因为启动客户端、刷新状态或连接 ChatGPT 而自动启动。浏览器控制仍通过 Runtime Chrome Bridge / CDP 执行。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,7,20,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#2A2312" BorderBrush="#4A3A17" BorderThickness="1" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                      <TextBlock Text="ACP DEFAULT OFF" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Connections -->
          <TabItem>
            <ScrollViewer Padding="28,26,28,30">
              <StackPanel>
                <TextBlock Text="连接" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="查看 ChatGPT、MCP 和兼容链路。凭据不会在此显示。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,22" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Runtime Public MCP" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="ChatGptConnectionSummary" Text="runtime.thegreatnovel.com → Cloudflare Tunnel → Runtime" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                      </StackPanel>
                      <Border Grid.Column="1" x:Name="ChatGptBadge" Background="#2A2312" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                        <TextBlock x:Name="ChatGptBadgeText" Text="NOT CONFIGURED" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                    <Separator Margin="0,16" Background="{StaticResource BorderBrush}" />
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="App 名称" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                      <TextBlock x:Name="ChatGptAppNameText" Grid.Column="1" Text="—" Margin="0,0,0,10"/>
                      <TextBlock Grid.Row="1" Text="公网 MCP" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                      <TextBlock x:Name="ChatGptTransportText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,0,0,10"/>
                      <TextBlock Grid.Row="2" Text="本地 MCP" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                      <TextBlock x:Name="LocalPublicMcpText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,0,0,10"/>
                      <TextBlock Grid.Row="3" Text="Cloudflare Tunnel" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                      <TextBlock x:Name="CloudflareTunnelText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,0,0,10"/>
                      <TextBlock Grid.Row="4" Text="认证" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                      <TextBlock x:Name="AuthStatusText" Grid.Row="4" Grid.Column="1" Text="—" Margin="0,0,0,10"/>
                      <TextBlock Grid.Row="5" Text="ChatGPT App" Style="{StaticResource MutedText}"/>
                      <TextBlock x:Name="ChatGptEndpointText" Grid.Row="5" Grid.Column="1" Text="—" TextWrapping="Wrap"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                      <Button x:Name="StartChatGptButton" Content="启动连接" Style="{StaticResource PrimaryButton}" Click="StartChatGpt_Click" Margin="0,0,8,0" />
                      <Button x:Name="StopChatGptButton" Content="暂停远程控制" Style="{StaticResource DangerButton}" Click="StopChatGpt_Click" Margin="0,0,8,0" />
                      <Button Content="打开连接配置" Style="{StaticResource GhostButton}" Click="OpenInstallDir_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ConnectionActionText" Text="固定架构：runtime.thegreatnovel.com/mcp → 独立 Cloudflare Tunnel → Runtime。" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="Local Runtime MCP" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="当前本地入口保留 stdio，不要求开放公网端口。" Style="{StaticResource MutedText}" Margin="0,6,0,14" />
                    <TextBlock Text="启动命令" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                    <TextBox x:Name="McpCommandTextBox" IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Content="复制命令" Style="{StaticResource GhostButton}" Click="CopyMcpCommand_Click" Margin="0,0,8,0" />
                      <Button Content="打开安装目录" Style="{StaticResource GhostButton}" Click="OpenInstallDir_Click" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="AgentDock fallback" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="runtime-core-preview 继续作为后备链路。Runtime Control 不会删除或修改官方 AgentDock。" Style="{StaticResource MutedText}" Margin="0,6,20,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="AgentDockConnectionText" Text="检查中" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Browser -->
          <TabItem>
            <ScrollViewer Padding="28,26,28,30">
              <StackPanel>
                <TextBlock Text="浏览器" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Runtime Chrome Bridge、Native Messaging 与视觉操作反馈。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,22" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="BrowserHeroDot" Width="10" Height="10" Fill="#667085" Margin="0,4,9,0" />
                        <TextBlock x:Name="BrowserHeroText" Text="Chrome Bridge" FontSize="18" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock x:Name="BrowserHeroDetail" Text="正在检查 Native Messaging…" Style="{StaticResource MutedText}" Margin="19,7,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Chrome 扩展页" Style="{StaticResource GhostButton}" Click="OpenChromeExtensions_Click" Margin="0,0,8,0" />
                      <Button Content="插件目录" Style="{StaticResource GhostButton}" Click="OpenExtensionDir_Click" />
                    </StackPanel>
                  </Grid>
                </Border>

                <UniformGrid Columns="2" Margin="0,0,0,14">
                  <Border Style="{StaticResource SmallCard}" Margin="0,0,7,0">
                    <StackPanel>
                      <TextBlock Text="Extension ID" Style="{StaticResource MutedText}" />
                      <TextBlock x:Name="ExtensionIdText" Text="—" FontSize="13" FontFamily="Consolas" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SmallCard}" Margin="7,0,0,0">
                    <StackPanel>
                      <TextBlock Text="Native Host" Style="{StaticResource MutedText}" />
                      <TextBlock x:Name="NativeHostText" Text="—" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="视觉反馈" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="以下由 Runtime Browser layer 默认启用，不需要 Chrome remote-debugging-port。" Style="{StaticResource MutedText}" Margin="0,6,0,16" />
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                      <Border Background="#0D171D" CornerRadius="10" Padding="13" Margin="0,0,7,0">
                        <StackPanel><TextBlock Text="发光 Cursor" FontWeight="SemiBold"/><TextBlock Text="移动 + 点击脉冲" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
                      </Border>
                      <Border Grid.Column="1" Background="#0D171D" CornerRadius="10" Padding="13" Margin="3,0,3,0">
                        <StackPanel><TextBlock Text="Runtime Tab" FontWeight="SemiBold"/><TextBlock Text="标签组 + favicon + title" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
                      </Border>
                      <Border Grid.Column="2" Background="#0D171D" CornerRadius="10" Padding="13" Margin="7,0,0,0">
                        <StackPanel><TextBlock Text="后台操作" FontWeight="SemiBold"/><TextBlock Text="不抢占前台页面" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Bridge PID" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="BridgePidText" Grid.Column="1" Text="—" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Text="最近启动" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="BridgeStartedText" Grid.Row="1" Grid.Column="1" Text="—"/>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ACP -->
          <TabItem>
            <ScrollViewer Padding="28,26,28,30">
              <StackPanel>
                <TextBlock Text="ACP" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Coding Agent 适配器是可选能力。Runtime Control 只检测，不自动启动。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,22" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Background="#18160F" BorderBrush="#3C341F">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="默认状态：Dormant" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="刷新、开机、ChatGPT MCP 扫描、acp_status 都不应该创建新的 ACP agent。" Style="{StaticResource MutedText}" Margin="0,6,20,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#2A2312" BorderBrush="#4A3A17" BorderThickness="1" CornerRadius="10" Padding="13,8" VerticalAlignment="Center">
                      <TextBlock Text="OFF BY DEFAULT" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                </Border>

                <TextBlock Text="Adapter detection" Style="{StaticResource SectionTitle}" />
                <UniformGrid Columns="3" Margin="0,0,0,14">
                  <Border Style="{StaticResource SmallCard}" Margin="0,0,7,0">
                    <StackPanel>
                      <TextBlock Text="Codex" FontSize="16" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Ellipse x:Name="CodexDot" Width="8" Height="8" Fill="#667085" Margin="0,4,8,0"/><TextBlock x:Name="CodexStatusText" Text="检查中" /></StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SmallCard}" Margin="3,0,3,0">
                    <StackPanel>
                      <TextBlock Text="Claude" FontSize="16" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Ellipse x:Name="ClaudeDot" Width="8" Height="8" Fill="#667085" Margin="0,4,8,0"/><TextBlock x:Name="ClaudeStatusText" Text="检查中" /></StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SmallCard}" Margin="7,0,0,0">
                    <StackPanel>
                      <TextBlock Text="Grok" FontSize="16" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Ellipse x:Name="GrokDot" Width="8" Height="8" Fill="#667085" Margin="0,4,8,0"/><TextBlock x:Name="GrokStatusText" Text="检查中" /></StackPanel>
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="启动规则" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="只有来自用户的明确 acp_start / acp_resume 请求才能启动 agent。此客户端不会提供“开机自动启动 ACP”开关。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Computer -->
          <TabItem>
            <ScrollViewer Padding="28,26,28,30">
              <StackPanel>
                <TextBlock Text="电脑控制" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Windows UI Automation 与本机权限边界。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,22" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Windows UI Automation" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock x:Name="ComputerPermissionText" Text="普通用户权限 · Ready" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="ComputerPermissionBadge" Background="#113025" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                      <TextBlock x:Name="ComputerPermissionBadgeText" Text="READY" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="Fallback policy" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Browser/CDP 真实失败且调用方提供 semantic UIA selector 时才允许 fallback。CSS selector 不会被自动转换为屏幕坐标点击。" Style="{StaticResource MutedText}" Margin="0,7,0,0" FontSize="13" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Background="#191116" BorderBrush="#40232D">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="远程控制 Kill Switch" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="当 ChatGPT 直接 MCP 配置完成后，此按钮调用本地 Stop-RuntimeForChatGPT.ps1，仅停止远程控制链路，不关闭 Chrome、不删除数据、不影响 AgentDock。" Style="{StaticResource MutedText}" Margin="0,7,20,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="暂停远程控制" Style="{StaticResource DangerButton}" Click="StopChatGpt_Click" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Logs/settings -->
          <TabItem>
            <ScrollViewer Padding="28,26,28,30">
              <StackPanel>
                <TextBlock Text="日志与设置" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="控制面板自身只读取非敏感状态，不展示 token、cookie、密码或浏览器凭据。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,22" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="开机行为" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="只控制 Runtime Control 客户端本身。不会自动开启 ACP。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="StartupCheckBox" Content="登录 Windows 后启动到托盘" Click="StartupCheckBox_Click" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="最近日志" FontSize="17" FontWeight="SemiBold" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="刷新日志" Style="{StaticResource GhostButton}" Click="RefreshLogs_Click" Margin="0,0,8,0" />
                        <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Click="OpenLogs_Click" />
                      </StackPanel>
                    </Grid>
                    <TextBox x:Name="LogsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="11" Height="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="#0D1117" BorderBrush="#202837" BorderThickness="0,1,0,0" Padding="18,0">
          <Grid>
            <TextBlock x:Name="FooterText" Text="准备就绪" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock x:Name="FooterTimeText" Text="" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
